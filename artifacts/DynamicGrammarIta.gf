-- DynamicGrammar generated by Neuro-Symbolic Grammar Induction Engine
abstract DynamicGrammarIta = {
  cat
    S ;
    OPN_R ;
    CLS_R ;
    OPN_S ;
    CLS_S ;
  fun
    rule_0_S : S -> S -> S ;
    rule_1_S : OPN_R -> CLS_R -> S ;
    rule_2_S : OPN_S -> CLS_S -> S ;
    rule_3_CLS_R : S -> CLS_R -> CLS_R ;
    rule_4_CLS_S : S -> CLS_S -> CLS_S ;
    rule_5_OPN_R : OPN_R ;
    rule_6_CLS_R : CLS_R ;
    rule_7_OPN_S : OPN_S ;
    rule_8_CLS_S : CLS_S ;
}

concrete DynamicGrammarItaEng of DynamicGrammarIta = {
  lincat
    S = Str ;
    OPN_R = Str ;
    CLS_R = Str ;
    OPN_S = Str ;
    CLS_S = Str ;
  lin
    rule_0_S x0 x1 = x0 ++ x1 ;
    rule_1_S x0 x1 = x0 ++ x1 ;
    rule_2_S x0 x1 = x0 ++ x1 ;
    rule_3_CLS_R x0 x1 = x0 ++ x1 ;
    rule_4_CLS_S x0 x1 = x0 ++ x1 ;
    rule_5_OPN_R = "(" ;
    rule_6_CLS_R = ")" ;
    rule_7_OPN_S = "[" ;
    rule_8_CLS_S = "]" ;
}
