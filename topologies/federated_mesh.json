{
  "federation_name": "lingologos_universal_federation",
  "version": "2.0.0",
  "description": "Topologia federata estesa con supporto a nodi illimitati, Git, HTTP e resolver dinamici",
  "nodes": [
    {
      "node_id": "local_core_node",
      "role": "Local Engine & State Manager",
      "transport": "local",
      "specs": {
        "grammar": "grammars/grammar.gf",
        "ontology": "ontologies/ontology.smt2",
        "seed": "seeds/seed_payload.json"
      },
      "outbound_channels": ["git_repo_node", "http_api_node"]
    },
    {
      "node_id": "git_repo_node",
      "role": "External Git Repository Source",
      "transport": "git",
      "remote_source": "https://github.com/detached-org/lingologos-modules.git",
      "branch": "main",
      "local_cache_path": "cache/nodes/git_repo_node",
      "specs": {
        "grammar": "modules/grammar.gf",
        "ontology": "modules/ontology.smt2",
        "seed": "modules/seed_payload.json"
      },
      "outbound_channels": ["local_core_node"]
    },
    {
      "node_id": "http_api_node",
      "role": "Remote HTTP Endpoint / Microservice",
      "transport": "http",
      "endpoint_url": "https://api.lingologos-inference.net/v1/evaluate",
      "auth_method": "bearer_token",
      "specs": {
        "grammar": "remote_specs/grammar_ref.gf",
        "ontology": "remote_specs/ontology_ref.smt2",
        "seed": "remote_specs/payload.json"
      },
      "outbound_channels": ["local_core_node"]
    }
  ],
  "routing_rules": [
    {
      "source": "local_core_node",
      "target": "git_repo_node",
      "condition": "FETCH_EXTERNAL_GRAMMAR_MODULES"
    },
    {
      "source": "git_repo_node",
      "target": "local_core_node",
      "condition": "MODULES_CLONED_AND_SYNCED"
    },
    {
      "source": "local_core_node",
      "target": "http_api_node",
      "condition": "OFFLOAD_VERIFICATION_TO_HTTP_ENDPOINT"
    },
    {
      "source": "http_api_node",
      "target": "local_core_node",
      "condition": "HTTP_EVALUATION_COMPLETED"
    }
  ]
}
