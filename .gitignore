__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
build/
dist/
*.so
*.dylib
*.dll

# Volatile orchestrator runtime state directory
runtime_state/

# Local specification cache of federated nodes: git sources are shallow cloned into
# cache/nodes/<node_id> by the transport resolver, so the folder is regenerated on demand.
cache/

# Local material policy for the two user-facing folders, expressed with the
# exclusion technique: the folders are ignored wholesale, and the shipped material
# is brought back into the index one entry at a time by the negation patterns
# below. Anything a user adds there -- a new corpus under datasets/<name>/, a new
# topology document under topologies/ -- stays out of git from the moment it is
# saved, with no further edit of this file. The last matching pattern wins, so the
# negations follow the folder patterns, and a folder is re-included before the
# files inside it are matched again. Tracked files are unaffected by these rules.
datasets/*
topologies/*

# Shipped datasets: the three federated node payloads and the multilingual
# companion corpus with its tools.
!datasets/agente_alfa/
!datasets/agente_beta/
!datasets/arbitro_logico/
!datasets/multilingual/

# Shipped topology document, read by tests/test_federation.py.
!topologies/federated_mesh.json

# Dataset companion folder: corpus and tools are versioned here,
# training outputs stay local. These two rules apply inside the re-included folder.
datasets/multilingual/checkpoints/
datasets/multilingual/_smoke/
.venv*/
venv/

# ASIC build products under asic_chip: Verilator model directories, simulator
# dumps and OpenLane run directories. The generated RTL under
# asic_chip/rtl/generated is deliberately versioned, not ignored.
asic_chip/sim/obj_dir/
asic_chip/sim/obj_dir_tb/
asic_chip/sim/obj_dir_topology/
asic_chip/sim/obj_dir_vvp/
asic_chip/sim/*.vcd
asic_chip/sim/*.vvp
asic_chip/openlane/runs/
asic_chip/openlane/*.log

# Exported fabrication and board artifacts, produced by
# asic_chip/scripts/export_artifacts.py. The tree lives outside the versioned
# sources and can be regenerated from any OpenLane run, so it is never
# committed. The layout patterns below also keep a GDS, LEF or DEF that was
# dropped somewhere else in the tree out of the index, which is what the
# export specification asks for. A copy exported to the Windows desktop with
# the --desktop flag is outside this repository entirely.
export_artifacts/
*.gds
*.lef
*.def

